# Secrets: never save keys to git
.env
.env.*

# Mac and tool clutter
.DS_Store
.claude/worktrees/
.ui-check/

# Raw downloads: data/fetch_msg.py can fetch these again any time
data/msg/raw/

# Local safety copies made before edits
_backup_before_changes/
**/_backup_before_changes/
data/nyc3d/raw/

# Video work files: renders, clips and audio are big and can be made again from the recipes (cut.js) and the studio.
# Recipes, scripts and notes in videos/ are still saved.
videos/**/*.mp4
videos/**/*.mov
videos/**/*.wav
videos/**/*.mp3
videos/**/*.jpg
videos/**/*.png
